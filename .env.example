# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Site
BASE_URL="http://localhost:3000"

# JWT secret — REQUIRED, no default. Must be at least 32 characters.
# The app refuses to sign or verify tokens without it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# Admin Setup
# After setting up the database, create an admin user with:
# npx tsx scripts/create-admin.ts admin@example.com yourpassword "Your Name"

# Then access the admin panel at:
# http://localhost:3000/admin/login
