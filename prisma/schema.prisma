// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String
}

model BlogPost {
  id          Int                 @id @default(autoincrement())
  title       String
  slug        String              @unique
  excerpt     String
  content     String
  author      String // name of the author
  publishedAt DateTime            @default(now())
  readTime    String
  tags        String // comma separated
  likes       Int                 @default(0)
  dislikes    Int                 @default(0)
  coverImage  String?
  reactions   BlogPostReaction[]
}

model BlogPostReaction {
  id          Int      @id @default(autoincrement())
  postId      Int
  userId      String   // Persistent visitor UUID
  userKey     String   // hash(postId, userId)
  deviceKey   String   // hash(postId, ip, fingerprint)
  fingerprint String?
  ipAddress   String?
  userAgent   String?
  reaction    String   // "like" | "dislike"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, deviceKey])
  @@index([postId, ipAddress])
  @@index([ipAddress, createdAt])
}

/// A portfolio project. Drives the "Selected projects" table on the
/// biography page (when featured) and the full /projects listing.
model Project {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  note         String   @default("")
  technologies String   @default("") // comma separated
  details      String   @default("") // one bullet per line
  liveDemoLink String   @default("")
  githubLink   String   @default("")
  imageUrl     String   @default("") // optional screenshot shown on /projects
  imageCaption String   @default("") // falls back to the title when empty
  featured     Boolean  @default(true) // show in the biography summary table
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

/// An editable section of the biography article. Rendered in `order`,
/// with `level` mapping to <h2>/<h3>. `body` holds sanitized HTML.
model ArticleSection {
  id        Int     @id @default(autoincrement())
  key       String  @unique // stable anchor id, used for TOC + deep links
  title     String
  level     Int     @default(2) // 2 => h2, 3 => h3
  body      String  @default("") // sanitized HTML
  order     Int     @default(0)
  inToc     Boolean @default(true)
  published Boolean @default(true)
  special   String  @default("") // "projects" => inject featured projects table
}

/// Key/value JSON store for the site "chrome" blocks that are not part of
/// the article flow: header bar, hero/lead, infobox, sidebar, footer, tags.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @default(now()) @updatedAt
}
